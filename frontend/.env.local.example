# Базовый URL backend API. Локально — backend на :3000. На проде (Hetzner + Coolify) — публичный URL backend-сервиса.
API_BASE_URL=http://localhost:3000

# Прод-домен сайта — основа для metadataBase/canonical/og:url/sitemap. По умолчанию bikebalirent.com.
NEXT_PUBLIC_SITE_URL=https://bikebalirent.com

# База для фото-URL (resolvePhotoUrl). '' = same-origin (/bikes/...). При переезде на CDN/R2/S3 — публичный URL бакета.
NEXT_PUBLIC_PHOTO_BASE_URL=

# Флаг "это боевой прод-домен" — управляет индексацией (robots.txt, sitemap.xml, meta robots).
# По умолчанию (не задан или != production) сайт ЗАКРЫТ от индексации — safe by default.
# Ставить SITE_ENV=production ТОЛЬКО на финальном деплое после DNS cutover на bikebalirent.com.
SITE_ENV=
