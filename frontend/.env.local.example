# Базовый URL backend API. Локально — backend на :3000. На проде (Hetzner + Coolify) — публичный URL backend-сервиса.
API_BASE_URL=http://localhost:3000

# Прод-домен сайта — основа для metadataBase/canonical/og:url/sitemap. По умолчанию bikebalirent.com.
NEXT_PUBLIC_SITE_URL=https://bikebalirent.com

# База для медиа-URL — и фото байков (resolvePhotoUrl), и скриншотов отзывов
# (resolveReviewScreenshotUrl). '' = same-origin (/bikes/..., /reviews/...).
# На проде — публичный URL R2-бакета. ВАЖНО: NEXT_PUBLIC_* вшивается в бандл на
# сборке, а не читается в рантайме — смена значения требует redeploy С РЕБИЛДОМ,
# иначе в HTML останется старый адрес.
NEXT_PUBLIC_PHOTO_BASE_URL=

# Флаг "это боевой прод-домен" — управляет индексацией (robots.txt, sitemap.xml, meta robots).
# По умолчанию (не задан или != production) сайт ЗАКРЫТ от индексации — safe by default.
# Ставить SITE_ENV=production ТОЛЬКО на финальном деплое после DNS cutover на bikebalirent.com.
SITE_ENV=

# Пароль Basic Auth для /internal/* и /api/admin/* (админка /internal/pricing).
# Без него доступ закрыт по умолчанию (middleware.js). Не коммитить реальное значение.
INTERNAL_ADMIN_PASSWORD=

# Общий секрет с backend (backend/.env INTERNAL_ADMIN_TOKEN, тот же
# значение с обеих сторон) — BFF /api/admin/* прикладывает его backend'у
# как заголовок X-Internal-Admin-Token. Без него backend отвечает 401 на
# всех 5 admin-роутерах. Не коммитить реальное значение.
INTERNAL_ADMIN_TOKEN=
