PORT=3000
NODE_ENV=development

# Локальная разработка (Postgres.app / homebrew postgresql)
DATABASE_URL=postgres://localhost:5432/mdb_platform

# Telegram-бот для эскалации заявок менеджеру (секрет, НЕ коммитить).
# Без токена заявки сохраняются, но уведомление помечается failed.
TELEGRAM_BOT_TOKEN=

# Общий секрет с frontend (frontend/.env.local INTERNAL_ADMIN_TOKEN, то же
# значение с обеих сторон) — требуется на 5 admin-роутерах (delivery/
# insurance/deposit/replacement-groups/seasonal-multipliers), см.
# middleware/internalAuth.js. Без него (или при несовпадении) — 401 на
# всех пяти. Не коммитить реальное значение.
INTERNAL_ADMIN_TOKEN=
